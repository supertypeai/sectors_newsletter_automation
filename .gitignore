# Local secrets. Never commit these.
.env
.env.*
!.env.example

# Local API-key fallback. SECTORS_API_KEY in the environment is the primary source;
# config.json is an optional local convenience and must never carry a key into git.
# Copy config.example.json if you want one.
*/config.json

# Scratch API fetches (sectors.mjs --save-dir output), never part of a reviewed diff.
newsletter/**/data/
newsletter/**/_draft/

# Real audience rows from the dbquery skill: contains PII, stays local, never committed.
newsletter/**/sample-rows.csv

# Claude Code skill discovery symlink, created by CI at runtime.
.claude/skills/

# Local end-to-end dry runs: real Sectors data, real Claude, real humanizing, no
# mailroom and no commit. Point NEWSLETTER_HOME here and the output stays yours.
newsletter-dryrun/
